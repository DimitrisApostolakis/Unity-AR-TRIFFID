# Example settings for the AR watcher (Assets/Editor/ArSplatInboxWatcher.cs).
# Copy to `.env` next to this file (it is gitignored) and adjust:
#   copy .env.example .env
#
# The Editor reads this file itself: Unity Hub passes no shell environment to it.
# A real environment variable with the same name overrides the value here.

# --- RabbitMQ (on the pipeline machine) -----------------------------------
# The laptop is outside the Docker network: point it at the pipeline machine's
# LAN address. The broker must publish AMQP on that address
# (RABBITMQ_BIND in the pipeline .env).
RABBITMQ_HOST=192.168.1.50
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Exchange shared with the rest of the pipeline, and the AR job routing key/queue.
RABBITMQ_EXCHANGE=pipeline.events
RABBITMQ_AR_ROUTING_KEY=ar.ready
RABBITMQ_AR_QUEUE=ar.queue

# --- Shared folder -----------------------------------------------------------
# Where the ground station writes each job (converted splat asset, mesh obj and
# geolocal json, one <stem>/ folder per job). Defaults to the
# samba_folder directory at the root of this repo. Point it at the mounted
# share once samba is set up, e.g. TRIFFID_SAMBA_DIR=\\192.168.1.50\unity or Z:\
TRIFFID_SAMBA_DIR=
